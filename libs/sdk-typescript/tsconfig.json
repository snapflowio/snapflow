{
	"extends": "../../tsconfig.base.json",
	"files": [],
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/**/testing/**"],
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"lib": ["es2024", "dom"],
		"esModuleInterop": true,
		"types": ["node"],
		"declaration": true,
		"declarationMap": true,
		"resolveJsonModule": true,
		"experimentalDecorators": false,
		"emitDecoratorMetadata": false
	}
}
