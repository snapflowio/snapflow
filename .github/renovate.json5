{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
  ],
  baseBranchPatterns: ["dev"],
  schedule: ["before 6am on monday"],
  minimumReleaseAge: "7 days",
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  labels: ["dependencies"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths", "pnpmDedupe"],
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
    minimumReleaseAge: null,
    schedule: ["at any time"],
  },
  packageRules: [
    {
      description: "Majors wait for approval on the dependency dashboard",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Every non-major update in one weekly pull request that squash-merges itself into dev once CI passes; promoting dev to main stays a manual step",
      groupName: "non-major dependencies",
      groupSlug: "non-major",
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
      automerge: true,
      automergeType: "pr",
      automergeStrategy: "squash",
    },
    {
      description: "One Go version across go.work, go.mod, images and the dev container, reviewed by hand; later rules win, so this follows the non-major group",
      groupName: "Go toolchain",
      matchDepNames: ["go", "golang"],
      automerge: false,
    },
    {
      description: "Flux image automation pins Snapflow's own images",
      matchPackageNames: ["ghcr.io/snapflowio/**"],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "golangci-lint installed by go install or by golangci-lint-action",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "golangci-lint/v2/cmd/golangci-lint@(?<currentValue>v\\S+)",
        "golangci-lint-action@\\S+ # \\S+\\n\\s+with:\\n\\s+version: (?<currentValue>v\\S+)",
      ],
      depNameTemplate: "github.com/golangci/golangci-lint/v2",
      datasourceTemplate: "go",
    },
    {
      customType: "regex",
      description: "golangci-lint in the dev container Go feature",
      managerFilePatterns: ["/^\\.devcontainer/devcontainer\\.json$/"],
      matchStrings: ['"golangciLintVersion": "(?<currentValue>[^"]+)"'],
      depNameTemplate: "golangci/golangci-lint",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
    {
      customType: "regex",
      description: "Go version of the dev container feature",
      managerFilePatterns: ["/^\\.devcontainer/devcontainer\\.json$/"],
      matchStrings: [
        '"ghcr\\.io/devcontainers/features/go:\\d+": \\{\\s*"version": "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "go",
      datasourceTemplate: "golang-version",
    },
    {
      customType: "regex",
      description: "Node version of the dev container feature",
      managerFilePatterns: ["/^\\.devcontainer/devcontainer\\.json$/"],
      matchStrings: [
        '"ghcr\\.io/devcontainers/features/node:\\d+": \\{\\s*"version": "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "node",
      datasourceTemplate: "node-version",
    },
    {
      customType: "regex",
      description: "pnpm version of the dev container Node feature",
      managerFilePatterns: ["/^\\.devcontainer/devcontainer\\.json$/"],
      matchStrings: ['"pnpmVersion": "(?<currentValue>[^"]+)"'],
      depNameTemplate: "pnpm",
      datasourceTemplate: "npm",
    },
    {
      customType: "regex",
      description: "Go tools run by version in workflows",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "(?<depName>golang\\.org/x/vuln)/cmd/govulncheck@(?<currentValue>v\\S+)",
        "(?<depName>github\\.com/rhysd/actionlint)/cmd/actionlint@(?<currentValue>v\\S+)",
      ],
      datasourceTemplate: "go",
    },
    {
      customType: "regex",
      description: "BuildKit version pinned in the release workflow",
      managerFilePatterns: ["/^\\.github/workflows/release\\.yml$/"],
      matchStrings: ["BUILDKIT_VERSION: (?<currentValue>v\\S+)"],
      depNameTemplate: "github.com/moby/buildkit",
      datasourceTemplate: "go",
    },
    {
      customType: "regex",
      description: "zizmor version passed to zizmor-action",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: ["zizmor-action@\\S+ # \\S+\\n\\s+with:\\n\\s+version: (?<currentValue>\\S+)"],
      depNameTemplate: "zizmor",
      datasourceTemplate: "pypi",
    },
    {
      customType: "regex",
      description: "Dev container CLI run with npx",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: ["@devcontainers/cli@(?<currentValue>\\S+)"],
      depNameTemplate: "@devcontainers/cli",
      datasourceTemplate: "npm",
    },
  ],
}
