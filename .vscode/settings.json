{
	"moon.binPath": "/usr/local/bin/moon",
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "always",
		"source.fixAll.biome": "always"
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[astro]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[svelte]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[tailwindcss]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[html]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[go]": {
		"editor.defaultFormatter": "golang.go",
		"editor.formatOnSave": true
	},
	"gopls": {
		"formatting.gofumpt": true,
		"build.directoryFilters": [
			"-**/.git",
			"-**/.moon",
			"-**/.tmp",
			"-**/dist",
			"-**/node_modules",
			"-**/reference"
		]
	},
	"tailwindCSS.experimental.configFile": {
		"apps/dashboard/src/lib/styles/global.css": "apps/dashboard/src/**",
		"apps/marketing/src/styles/global.css": "apps/marketing/src/**"
	},
	"tailwindCSS.files.exclude": [
		"**/.git/**",
		"**/.moon/**",
		"**/.tmp/**",
		"**/dist/**",
		"**/node_modules/**",
		"**/reference/**",
		"**/references/**"
	],
	"files.associations": {
		"**/deploy/charts/*/templates/*.yaml": "helm",
		"**/deploy/charts/*/templates/*.tpl": "helm"
	},
	"git.detectSubmodules": false,
	"editor.quickSuggestions": {
		"other": true,
		"comments": false,
		"strings": false
	},
	"editor.suggestOnTriggerCharacters": true,
	"files.watcherExclude": {
		"**/.svelte-kit/**": true,
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/.tmp/**": true,
		"**/.pnpm-store/**": true,
		"**/node_modules/**": true,
		"**/.moon/**": true,
		"**/checkpoints/**": true,
		"**/dist/**": true,
		"**/reference/**": true,
		"**/references/**": true,
		"**/tmp/**": true,
		"**/coverage/**": true
	},
	"search.exclude": {
		"**/.svelte-kit/**": true,
		"**/.git/**": true,
		"**/.tmp/**": true,
		"**/.pnpm-store/**": true,
		"**/node_modules/**": true,
		"**/.moon/**": true,
		"**/checkpoints/**": true,
		"**/dist/**": true,
		"**/reference/**": true,
		"**/references/**": true,
		"**/tmp/**": true,
		"**/coverage/**": true
	},
	"git.ignoreLimitWarning": true
}
