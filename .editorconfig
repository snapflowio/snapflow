root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Biome and gofumpt format these with tabs.
[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,astro,css,html,go}]
indent_style = tab

[{go.mod,go.sum,go.work}]
indent_style = tab

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
