# Values several stages share; Flux substitutes them as ${NAME} into the
# infrastructure-configs, infrastructure-backups, platform and apps stages.

# The site, dashboard (/dashboard) and api (/api). Dynamic DNS
# (infrastructure/configs/cloudflare-ddns.yaml) keeps its proxied A record
# current; deploy/tofu/cloudflare owns the zone settings and the Origin Rule to
# Traefik's Cloudflare-only entrypoint.
PUBLIC_DOMAIN=snapflow.io
# The image registry (snapshot-manager), proxied and routed like
# PUBLIC_DOMAIN. Its blobs live in OBJECT_STORAGE_SNAPSHOT_BUCKET, not on this
# server.
REGISTRY_DOMAIN=registry.snapflow.io
# The sandbox zone. It must be its own registrable domain so sandbox pages are
# cross-site to the dashboard (the api refuses to start otherwise); file it
# with the Public Suffix List (private section) so each sandbox host is its
# own site. The api creates every sandbox CNAME with
# SNAPFLOW_CLOUDFLARE_API_TOKEN, which needs Zone:Read, DNS:Edit and SSL and
# Certificates:Edit on this zone; the worker also keeps the zone's
# authenticated origin pull certificate issued from OpenBao and rotated. The
# snapflow/cloudflare-dns token (cert-manager DNS-01 and dynamic DNS) needs
# Zone:DNS:Edit on both PUBLIC_DOMAIN's zone and this one.
PLATFORM_DOMAIN=snapflow.run
# The Cloudflare for SaaS fallback origin and the CNAME target customers point
# their custom domains at. deploy/tofu/cloudflare creates it as a proxied
# CNAME to the first EDGE_HOSTS entry, because Cloudflare requires a proxied
# fallback origin while edge hosts stay DNS-only for machine tunnels. Enable
# Custom Hostnames on this zone (SSL/TLS > Custom Hostnames) before applying.
CUSTOM_HOSTNAME_TARGET=domains.snapflow.run
# Public hosts of the edges that run on this cluster's public IP, comma
# separated; dynamic DNS keeps their A records current. Each must match an
# edges[].publicHost value in apps/production/edge/release.yaml.
EDGE_HOSTS=edge.snapflow.run
# The origin connector dials ORIGIN_EDGE_TUNNELS (edge tunnel host:port list)
# as origin site ORIGIN_SITE; edges pass ORIGIN_HOSTS through to it. It stays
# undeployed while ORIGIN_EDGE_TUNNELS is empty.
ORIGIN_SITE=titan
ORIGIN_HOSTS=snapflow.io,registry.snapflow.io
ORIGIN_EDGE_TUNNELS=
# The api sends from noreply@ this domain through Resend. Add it under Domains
# in Resend and copy its records into the zone, DNS only: the DKIM TXT record
# resend._domainkey.mail, the MX (priority 10) and SPF TXT records on
# send.mail, and a DMARC TXT record on _dmarc (start at p=none). Create a
# Resend API key with sending access to this domain only for RESEND_API_KEY.
EMAIL_DOMAIN=mail.snapflow.io
# User objects and registry blobs live only in R2, with no copy in the cluster
# or in the backups: the R2 S3 endpoint the api and snapshot-manager use, the
# two buckets and the location hint they are created with
# (moon run deploy:cloudflare). Each bucket has its own R2
# token in OpenBao at snapflow/storage.
# A bucket's location hint cannot change after creation. The account's
# "snapflow" bucket is the public cdn.snapflow.io bucket; never store user
# objects in it.
OBJECT_STORAGE_ENDPOINT=https://74bcfe44629d279b31d58f3dbd5170af.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=snapflow-objects
OBJECT_STORAGE_SNAPSHOT_BUCKET=snapflow-snapshots
OBJECT_STORAGE_LOCATION=enam
# Off-cluster backups (infrastructure/backups and platform/data/postgres-backups.yaml):
# the R2 S3 endpoint of the Cloudflare account that owns the bucket.
BACKUP_S3_ENDPOINT=https://74bcfe44629d279b31d58f3dbd5170af.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=snapflow-backups
