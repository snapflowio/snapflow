	"scripts": {
		"build": "NODE_ENV=development nest build",
		"build:production": "NODE_ENV=production nest build",
		"dev": "nest start --watch --no-shell --env-file .env",
		"migration:generate:init": "pnpm build:production && node --env-file-if-exists=.env ../../node_modules/@mikro-orm/cli/cli.js migration:create --path src/migrations --config ../../dist/apps/api/migrations/data-source.mjs",
		"migration:generate:pre-deploy": "pnpm build:production && node --env-file-if-exists=.env ../../node_modules/@mikro-orm/cli/cli.js migration:create --path src/migrations/pre-deploy --config ../../dist/apps/api/migrations/pre-deploy/data-source.mjs",
		"migration:generate:post-deploy": "pnpm build:production && node --env-file-if-exists=.env ../../node_modules/@mikro-orm/cli/cli.js migration:create --path src/migrations/post-deploy --config ../../dist/apps/api/migrations/post-deploy/data-source.mjs",
		"migration:run:init": "node --env-file-if-exists=.env ../../node_modules/@mikro-orm/cli/cli.js migration:up --config ../../dist/apps/api/migrations/data-source.mjs",
		"migration:run:pre-deploy": "node --env-file-if-exists=.env ../../node_modules/@mikro-orm/cli/cli.js migration:up --config ../../dist/apps/api/migrations/pre-deploy/data-source.mjs",
		"migration:run:post-deploy": "node --env-file-if-exists=.env ../../node_modules/@mikro-orm/cli/cli.js migration:up --config ../../dist/apps/api/migrations/post-deploy/data-source.mjs",
		"migration:revert": "node --env-file-if-exists=.env ../../node_modules/@mikro-orm/cli/cli.js migration:down --config ../../dist/apps/api/migrations/data-source.mjs",
		"test": "tsc -p tsconfig.test.json && NODE_ENV=test nest build && node --test \"../../dist/apps/api-tests/**/*.test.mjs\""
	}
}
