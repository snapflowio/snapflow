{
	auto_https off
	admin off
}

:8080 {
	root * /srv/snapflow
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' __BOOTSTRAP_SCRIPT_HASH__ https://js.stripe.com https://*.js.stripe.com https://checkout.stripe.com https://connect-js.stripe.com https://maps.googleapis.com; style-src 'self'; style-src-attr 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.stripe.com https://*.link.com; font-src 'self'; connect-src 'self' https://*.stripe.com https://*.stripe.network https://link.com https://*.link.com https://maps.googleapis.com; frame-src https://*.{host}:* https://*.stripe.com https://*.stripe.network https://link.com https://*.link.com; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(self \"https://js.stripe.com\" \"https://*.js.stripe.com\" \"https://checkout.stripe.com\" \"https://link.com\" \"https://*.link.com\"), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		@assets path /_app/immutable/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@application not path /_app/immutable/*
		header @application Cache-Control "no-cache"

		try_files {path} /200.html
		file_server
	}
}
