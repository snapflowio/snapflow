[Unit]
Description=Apply a verified Snapflow edge update
Documentation=https://github.com/snapflowio/snapflow
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=15min
User=root
Group=root
UMask=0077
ExecStart=/usr/local/bin/snapflow edge update
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/snapflow-edge /var/lib/snapflow-edge-release
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
