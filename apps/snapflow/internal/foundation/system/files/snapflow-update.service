[Unit]
Description=Stage and apply a verified Snapflow update
Documentation=https://github.com/snapflowio/snapflow
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=1h
User=root
Group=root
UMask=0077
ExecStart=/usr/local/bin/snapflow update --profile production --scheduled
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/snapflow /var/lib/snapflow/releases /run/snapflow /etc/systemd/system /etc/tmpfiles.d /etc/sysctl.d /usr/local/bin
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

